NODE_ENV=development
PORT=3000

APP_SESSION_SECRET="your-super-secret-session-key-at-least-32-chars-long"
APP_DATA_ENCRYPTION_KEY="your-data-encryption-key-at-least-32-chars-long"
BAILEYS_SERVICE_URL=http://127.0.0.1:3001
BAILEYS_SERVICE_PORT=3001
BAILEYS_SERVICE_TOKEN=replace-with-random-32-byte-token
FRONTEND_APP_URL=https://ec738f86f1fd.apps-tunnel.monday.app
BAILEYS_INGEST_TIMING=false
BAILEYS_SOCKET_VERSION=2,3000,1035176028
WHATSAPP_MESSAGE_RETENTION_HOURS=24

# Official WhatsApp bridge. WABA_RELAY_SECRET must match
# ATTIO_CRM_OS_RELAY_SECRET in the existing WhatSync app.
WABA_ONBOARDING_URL=https://whatsync.appstronauts.shop/api/auth/whatsapp
WABA_RELAY_SECRET=replace-with-same-secret-as-old-app # openssl rand -hex 32

ATTIO_CLIENT_ID=
ATTIO_CLIENT_SECRET=
ATTIO_REDIRECT_URI=https://ec738f86f1fd.apps-tunnel.monday.app/api/integration/oauth/callback
ATTIO_OAUTH_STATE_SECRET=
ATTIO_SCOPES="object_configuration:read-write record_permission:read note:read-write"

DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Cloudflare R2 Media Storage Setting (Required if handling Media Sync)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
