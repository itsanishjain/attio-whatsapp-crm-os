{
  "name": "attio-crm-whatsapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,baileys,worker,frontend -c blue,yellow,magenta,green \"bun run dev:server\" \"bun run dev:baileys\" \"bun run dev:worker\" \"bun run dev:frontend\"",
    "dev:no-worker": "concurrently -k -n server,baileys,frontend -c blue,yellow,green \"bun run dev:server\" \"bun run dev:baileys\" \"bun run dev:frontend\"",
    "dev:baileys": "bun --watch server/baileys-index.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:worker": "bun --watch server/worker.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "bun run build:frontend && bun run build:server && bun run build:baileys && bun run build:worker",
    "build:baileys": "bun build server/baileys-index.ts --outdir dist/baileys --target bun --external @libsql/client --external libsql",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build:server": "bun build server/index.ts --outdir dist/server --target bun --external @libsql/client --external libsql",
    "build:worker": "bun build server/worker.ts --outdir dist/worker --target bun --external @libsql/client --external libsql",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down --remove-orphans",
    "docker:up": "docker compose up -d --build --remove-orphans",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run server/db/migrate.ts",
    "db:migrate:prod": "bun --env-file=.env.production run server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:push:prod": "bun --env-file=.env.production drizzle-kit push --config=drizzle-prod.config.ts",
    "db:studio": "bunx drizzle-kit studio --port=3012",
    "db:studio:prod": "bun --env-file=.env.production run drizzle-kit studio --port=3013 --config=drizzle-prod.config.ts",
    "deploy:server": "bash ./scripts/server-deploy.sh",
    "magic-link": "bun scripts/generate-magic-link.ts",
    "magic-link:prod": "bun --env-file=.env.production scripts/generate-magic-link.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-select": "^2.2.6",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.133.16",
    "@tanstack/router-vite-plugin": "^1.166.35",
    "@whatsapp-crm/core": "workspace:*",
    "@whiskeysockets/baileys": "6.7.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.9.7",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "bun-types": "^1.3.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
