NODE_ENV=production
PORT=3000

APP_SESSION_SECRET=
APP_DATA_ENCRYPTION_KEY=
BAILEYS_SERVICE_URL=http://baileys:3001
BAILEYS_SERVICE_PORT=3001
BAILEYS_SERVICE_TOKEN=
FRONTEND_APP_URL=https://attio.whasupcrm.com
BAILEYS_INGEST_TIMING=false
WHATSAPP_MESSAGE_RETENTION_HOURS=24

# Official WhatsApp bridge. WABA_RELAY_SECRET must match
# ATTIO_CRM_OS_RELAY_SECRET in the existing WhatSync app.
WABA_ONBOARDING_URL=https://whatsync.appstronauts.shop/api/auth/whatsapp
WABA_RELAY_SECRET=

ATTIO_CLIENT_ID=
ATTIO_CLIENT_SECRET=
ATTIO_REDIRECT_URI=https://attio.whasupcrm.com/api/integration/oauth/callback
ATTIO_OAUTH_STATE_SECRET=
ATTIO_SCOPES="object_configuration:read-write record_permission:read note:read-write"

DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare R2 Media Storage Setting (Required if handling Media Sync)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
